{% comment %}
  Image snippet with lazy loading
  Usage: {% render 'image', image: product.featured_image, width: 600, alt: product.title %}
{% endcomment %}

{% assign image_width = width | default: 600 %}
{% assign image_alt = alt | image.alt | default: '' %}
{% assign image_class = class | default: '' %}

<img src="{{ image | image_url: width: image_width }}" 
     alt="{{ image_alt | escape }}"
     class="{{ image_class }}"
     loading="lazy"
     width="{{ image_width }}"
     height="{{ image_width | divided_by: image.aspect_ratio | round }}">
