{% comment %}
  CSS Variables & Font Faces - Design System
  Fuente Helvetica World: Encabezados
  Fuente Helixa: Párrafos y contenido general
{% endcomment %}

<style>
  /* ========== Font Faces ========== */
  
  /* Helvetica World - Para encabezados */
  @font-face {
    font-family: 'Helvetica World';
    src: url('{{ "helvetica-world.woff" | asset_url }}') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  
  @font-face {
    font-family: 'Helvetica World';
    src: url('{{ "helvetica-world-bold.woff" | asset_url }}') format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  
  /* Helixa - Para párrafos y contenido general */
  @font-face {
    font-family: 'Helixa';
    src: url('{{ "Helixa-Light.woff" | asset_url }}') format('woff');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }
  
  @font-face {
    font-family: 'Helixa';
    src: url('{{ "Helixa-Book.woff" | asset_url }}') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  
  @font-face {
    font-family: 'Helixa';
    src: url('{{ "Helixa-Regular.woff" | asset_url }}') format('woff');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  
  @font-face {
    font-family: 'Helixa';
    src: url('{{ "Helixa-Bold.woff" | asset_url }}') format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  /* ========== CSS Variables ========== */
  :root {
    /* Fuentes */
    --font-helvetica-world: 'Helvetica World', Arial, sans-serif;
    --font-helixa: 'Helixa', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    
    /* Colores - Texto */
    --color-title-white: #FFFFFF;
    --color-paragraph-white: #FFFFFF;
    --color-title-dark: #CB6CE6;
    --color-paragraph-dark: #6B6B6B;

    /* Colores - Botones Fondo Blanco */
    --button-bg-white: #FFFFFF;
    --button-text-on-white: #CB6CE6;

    /* Colores - Botones Fondo Oscuro */
    --button-bg-dark: #F0ECDF;
    --button-text-on-dark: #6B550E;

    /* Colores - Fondos adicionales */
    --bg-primary: #FFFFFF;
    --bg-white: #FFFFFF;
    --accent-color: #CB6CE6;

    /* Layout */
    --page-width: 1512px;
    --page-padding: 20px;

    /* Botones - CTAs (redondos) */
    --btn-cta-radius: 1000px;
    --btn-cta-padding: 25px 35px;

    /* Botones - Add to Cart en carruseles */
    --btn-cart-radius: 6px;
    --btn-cart-padding: 14px 26px;

    /* Colores de marca - tokens nuevos (rebrand fucsia) */
    --color-bg: #FFFFFF;
    --color-fg: #111111;
    --color-fg-muted: #6B6B6B;
    --color-border: #E5E5E5;
    --color-accent: #CB6CE6;
    --color-accent-solid: #B125D9;
    --color-accent-hover: #BC41DF;
    --color-accent-active: #9920BC;
    --color-accent-a08: rgba(203, 108, 230, 0.08);
    --color-accent-a10: rgba(203, 108, 230, 0.10);
    --color-accent-a15: rgba(203, 108, 230, 0.15);
    --color-accent-a20: rgba(203, 108, 230, 0.20);
    --color-accent-a30: rgba(203, 108, 230, 0.30);
    --color-accent-a40: rgba(203, 108, 230, 0.40);
  }
</style>
