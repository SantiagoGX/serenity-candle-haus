{% comment %}
  CSS Variables & Font Faces - Design System
  Fuente Helvetica World: Encabezados
  Fuente Helixa: Párrafos y contenido general
{% endcomment %}

<style>
  /* ========== Font Faces ========== */
  
  /* Helvetica World - Para encabezados */
  @font-face {
    font-family: 'Helvetica World';
    src: url('{{ "helvetica-world.woff" | asset_url }}') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  
  @font-face {
    font-family: 'Helvetica World';
    src: url('{{ "helvetica-world-bold.woff" | asset_url }}') format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  
  /* Helixa - Para párrafos y contenido general */
  @font-face {
    font-family: 'Helixa';
    src: url('{{ "Helixa-Light.woff" | asset_url }}') format('woff');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }
  
  @font-face {
    font-family: 'Helixa';
    src: url('{{ "Helixa-Book.woff" | asset_url }}') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  
  @font-face {
    font-family: 'Helixa';
    src: url('{{ "Helixa-Regular.woff" | asset_url }}') format('woff');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  
  @font-face {
    font-family: 'Helixa';
    src: url('{{ "Helixa-Bold.woff" | asset_url }}') format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  /* ========== CSS Variables ========== */
  :root {
    /* Fuentes */
    --font-helvetica-world: 'Helvetica World', Arial, sans-serif;
    --font-helixa: 'Helixa', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    
    /* Colores - Texto */
    --color-title-white: #FFFFFF;
    --color-paragraph-white: #FFFFFF;
    --color-title-dark: #6B550E;
    --color-paragraph-dark: #6D6C6C;
    
    /* Colores - Botones Fondo Blanco */
    --button-bg-white: #FFFFFF;
    --button-text-on-white: #6B550E;
    
    /* Colores - Botones Fondo Oscuro */
    --button-bg-dark: #F0ECDF;
    --button-text-on-dark: #6B550E;
    
    /* Colores - Fondos adicionales */
    --bg-primary: #F0ECDF;
    --bg-white: #FFFFFF;
    --accent-color: #6B550E;
    
    /* Layout */
    --page-width: 1512px;
    --page-padding: 20px;
    
    /* Botones - CTAs (redondos) */
    --btn-cta-radius: 1000px;
    --btn-cta-padding: 25px 35px;
    
    /* Botones - Add to Cart en carruseles */
    --btn-cart-radius: 6px;
    --btn-cart-padding: 14px 26px;
  }
</style>
