{% assign recommendations = product.metafields.shopify--discovery--product_recommendation.related_products.value | default: product.collections.first.products | where: 'id', product.id | reject | limit: 3 %}

<section class="product-recommendations" data-section-id="{{ section.id }}">
  <div class="product-recommendations__container">
    <h2 class="product-recommendations__title">{{ section.settings.title | default: 'ALSO LIKE' }}</h2>
    
    <div class="product-recommendations__grid">
      {% if recommendations.size > 0 %}
        {% for rec_product in recommendations limit: 3 %}
          {% assign product_category = rec_product.metafields.custom.category | default: rec_product.collections.first.title | default: 'Candle' %}
          <div class="product-recommendations__item">
            <div class="product-card-carousel">
              <div class="product-card-carousel__image-wrapper">
                <span class="product-card-carousel__category">{{ product_category | upcase }}</span>
                <button class="product-card-carousel__wishlist" data-wishlist-btn data-product-id="{{ rec_product.id }}" aria-label="Add to wishlist">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                </button>
                <a href="{{ rec_product.url }}" class="product-card-carousel__link">
                  {% if rec_product.featured_image %}
                    {{ rec_product.featured_image | image_url: width: 600 | image_tag: 
                      loading: 'lazy',
                      class: 'product-card-carousel__image',
                      alt: rec_product.title
                    }}
                  {% else %}
                    <div class="product-card-carousel__placeholder"></div>
                  {% endif %}
                </a>
              </div>
              <div class="product-card-carousel__info">
                <div class="product-card-carousel__meta">
                  <h3 class="product-card-carousel__name">{{ rec_product.title }}</h3>
                  <span class="product-card-carousel__price">{{ rec_product.price | money }}</span>
                </div>
                {% if rec_product.first_available_variant %}
                  <button class="product-card-carousel__add-btn" data-add-to-cart data-variant-id="{{ rec_product.first_available_variant.id }}">
                    {{ section.settings.add_button_text | default: 'ADD +' }}
                  </button>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <div class="product-recommendations__item">
            <div class="product-card-carousel">
              <div class="product-card-carousel__image-wrapper">
                <span class="product-card-carousel__category">CATEGORY</span>
                <button class="product-card-carousel__wishlist" aria-label="Add to wishlist">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                </button>
                <div class="product-card-carousel__placeholder"></div>
              </div>
              <div class="product-card-carousel__info">
                <div class="product-card-carousel__meta">
                  <h3 class="product-card-carousel__name">Cute Candle</h3>
                  <span class="product-card-carousel__price">$1,900.78</span>
                </div>
                <button class="product-card-carousel__add-btn">ADD +</button>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<style>
  .product-recommendations {
    padding: 80px 24px;
    background: #FDFBF5;
  }

  .product-recommendations__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .product-recommendations__title {
    font-family: var(--font-helvetica-world);
    font-size: clamp(32px, 5vw, 48px);
    color: var(--color-title-dark, #6B550E);
    text-transform: uppercase;
    letter-spacing: -4px;
    text-align: center;
    margin: 0 0 48px 0;
  }

  .product-recommendations__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 768px) {
    .product-recommendations__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .product-recommendations__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Reuse styles from product carousel */
  .product-card-carousel {
    background: transparent;
  }

  .product-card-carousel__image-wrapper {
    position: relative;
    aspect-ratio: 4 / 5;
    background: #e8e4d9;
    overflow: hidden;
    border-radius: 4px;
  }

  .product-card-carousel__category {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.95);
    font-family: var(--font-helvetica-world);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-title-dark, #6B550E);
    border-radius: 2px;
  }

  .product-card-carousel__wishlist {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    width: 36px;
    height: 36px;
    background: #fff;
    border: none;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-title-dark, #6B550E);
    transition: all 0.3s ease;
  }

  .product-card-carousel__wishlist:hover {
    background: var(--color-title-dark, #6B550E);
    color: #fff;
  }

  .product-card-carousel__wishlist.is-active svg {
    fill: currentColor;
  }

  .product-card-carousel__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .product-card-carousel:hover .product-card-carousel__image {
    transform: scale(1.05);
  }

  .product-card-carousel__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e8e4d9 0%, #d4d0c5 100%);
  }

  .product-card-carousel__info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
  }

  .product-card-carousel__meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .product-card-carousel__name {
    font-family: var(--font-helvetica-world);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-title-dark, #6B550E);
    margin: 0;
  }

  .product-card-carousel__price {
    font-family: var(--font-helixa);
    font-size: 14px;
    color: var(--color-paragraph-dark, #6D6C6C);
  }

  .product-card-carousel__add-btn {
    padding: 10px 20px;
    background: #fff;
    border: 1px solid rgba(107, 85, 14, 0.15);
    border-radius: 6px;
    font-family: var(--font-helvetica-world);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-title-dark, #6B550E);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .product-card-carousel__add-btn:hover {
    background: var(--color-title-dark, #6B550E);
    color: #fff;
    border-color: var(--color-title-dark, #6B550E);
  }
</style>

<script>
  (function() {
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    // Wishlist functionality
    const wishlistBtns = section.querySelectorAll('[data-wishlist-btn]');
    
    function getWishlist() {
      try {
        const stored = localStorage.getItem('serenity_wishlist');
        return stored ? JSON.parse(stored) : [];
      } catch (e) {
        return [];
      }
    }
    
    function saveWishlist(wishlist) {
      localStorage.setItem('serenity_wishlist', JSON.stringify(wishlist));
      const headerCount = document.querySelector('[data-wishlist-count]');
      if (headerCount) {
        headerCount.textContent = wishlist.length;
        headerCount.style.display = wishlist.length > 0 ? 'flex' : 'none';
      }
    }

    const wishlist = getWishlist();
    wishlistBtns.forEach(function(btn) {
      const productId = btn.dataset.productId;
      if (wishlist.includes(productId)) {
        btn.classList.add('is-active');
      }

      btn.addEventListener('click', function() {
        let currentWishlist = getWishlist();
        
        if (btn.classList.contains('is-active')) {
          currentWishlist = currentWishlist.filter(function(id) { return id !== productId; });
          btn.classList.remove('is-active');
        } else {
          currentWishlist.push(productId);
          btn.classList.add('is-active');
        }
        
        saveWishlist(currentWishlist);
      });
    });

    // Add to cart functionality
    const addToCartBtns = section.querySelectorAll('[data-add-to-cart]');
    addToCartBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        const variantId = btn.dataset.variantId;
        if (!variantId) return;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            items: [{
              id: variantId,
              quantity: 1
            }]
          })
        })
        .then(function(response) { return response.json(); })
        .then(function() {
          return fetch('/cart.js');
        })
        .then(function(response) { return response.json(); })
        .then(function(cart) {
          const cartCount = document.querySelector('[data-cart-count]');
          if (cartCount) {
            cartCount.textContent = cart.item_count;
            cartCount.style.display = cart.item_count > 0 ? 'flex' : 'none';
          }
          
          btn.textContent = 'ADDED!';
          setTimeout(function() {
            btn.textContent = '{{ section.settings.add_button_text | default: "ADD +" }}';
          }, 2000);
        })
        .catch(function(error) {
          console.error('Error adding to cart:', error);
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Product Recommendations",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "ALSO LIKE"
    },
    {
      "type": "text",
      "id": "add_button_text",
      "label": "Add to cart button text",
      "default": "ADD +"
    }
  ],
  "presets": [
    {
      "name": "Product Recommendations"
    }
  ]
}
{% endschema %}
