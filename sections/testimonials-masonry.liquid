{% assign testimonials = section.blocks | where: 'type', 'testimonial' %}
{% assign total_testimonials = testimonials.size %}
{% assign initial_limit = 6 %}

<section class="testimonials-section" data-section-id="{{ section.id }}">
  <div class="testimonials__container">
    <div class="testimonials__header">
      <h2 class="testimonials__title">{{ section.settings.title | default: 'OUR CLIENTS SAYS' }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="testimonials__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
      
      <div class="testimonials__rating">
        {% if section.settings.laurel_left != blank %}
          <div class="testimonials__laurel-wrapper" style="height: {{ section.settings.laurel_height }}px;">
            {{ section.settings.laurel_left | image_url: width: 200 | image_tag: 
              class: 'testimonials__laurel-img',
              alt: 'Laurel left'
            }}
          </div>
        {% endif %}
        
        {% if section.settings.rating_image != blank %}
          <div class="testimonials__rating-image-wrapper" style="height: {{ section.settings.rating_image_height }}px;">
            {{ section.settings.rating_image | image_url: width: 400 | image_tag: 
              class: 'testimonials__rating-image',
              alt: 'Rating'
            }}
          </div>
        {% else %}
          <div class="testimonials__rating-content">
            <div class="testimonials__rating-stars">
              <span class="testimonials__rating-number">{{ section.settings.rating | default: '4.8' }}</span>
              <span class="testimonials__stars">★★★★★</span>
            </div>
            {% if section.settings.rating_text != blank %}
              <p class="testimonials__rating-text">{{ section.settings.rating_text }}</p>
            {% endif %}
          </div>
        {% endif %}
        
        {% if section.settings.laurel_right != blank %}
          <div class="testimonials__laurel-wrapper testimonials__laurel-wrapper--right" style="height: {{ section.settings.laurel_height }}px;">
            {{ section.settings.laurel_right | image_url: width: 200 | image_tag: 
              class: 'testimonials__laurel-img',
              alt: 'Laurel right'
            }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="testimonials__grid" data-testimonials-grid>
      {% for block in testimonials limit: initial_limit %}
        {% assign star_count = block.settings.rating | default: 5 %}
        <div class="testimonial-card" data-index="{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars">{% for s in (1..5) %}{% if s <= star_count %}★{% else %}☆{% endif %}{% endfor %}</div>
          <h3 class="testimonial-card__title">{{ block.settings.title | default: '¡Por fin encontré la app de finanzas perfecta!' }}</h3>
          <p class="testimonial-card__text">{{ block.settings.text | default: 'He probado muchas aplicaciones de finanzas personales...' }}</p>
          <span class="testimonial-card__author">{{ block.settings.author | default: 'María' }}</span>
        </div>
      {% endfor %}
      
      {% if total_testimonials == 0 %}
        {% for i in (1..6) %}
          <div class="testimonial-card testimonial-card--placeholder">
            <div class="testimonial-card__stars">★★★★★</div>
            <h3 class="testimonial-card__title">¡Por fin encontré la app de finanzas perfecta!</h3>
            <p class="testimonial-card__text">"He probado muchas aplicaciones de finanzas personales, pero ninguna se ajustaba a mis necesidades hasta que encontré Expense Tracker - MonAi. Es, con diferencia, la mejor app para rastrear gastos e ingresos con una organización adecuada."</p>
            <span class="testimonial-card__author">María</span>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {% if total_testimonials > initial_limit %}
      <div class="testimonials__more" data-testimonials-more style="display: none;">
        {% for block in testimonials offset: initial_limit %}
          {% assign star_count = block.settings.rating | default: 5 %}
          <div class="testimonial-card" {{ block.shopify_attributes }}>
            <div class="testimonial-card__stars">{% for s in (1..5) %}{% if s <= star_count %}★{% else %}☆{% endif %}{% endfor %}</div>
            <h3 class="testimonial-card__title">{{ block.settings.title | default: '¡Por fin encontré la app de finanzas perfecta!' }}</h3>
            <p class="testimonial-card__text">{{ block.settings.text }}</p>
            <span class="testimonial-card__author">{{ block.settings.author | default: 'María' }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if total_testimonials > initial_limit %}
      <button class="testimonials__load-more" data-load-more>
        <span>VIEW MORE</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </button>
    {% endif %}
  </div>
</section>

<style>
  .testimonials-section {
    padding: 100px 24px;
    background: var(--color-bg);
  }

  .testimonials__container {
    max-width: 1212px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .testimonials__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .testimonials__title {
    font-family: var(--font-helvetica-world);
    font-size: clamp(40px, 6vw, 64px);
    color: var(--color-fg);
    text-transform: uppercase;
    letter-spacing: -4px;
    margin: 0 0 16px 0;
    letter-spacing: 2px;
  }

  .testimonials__subtitle {
    font-family: var(--font-helvetica-world);
    font-size: 16px;
    color: var(--color-fg-muted);
    margin: 0 0 32px 0;
  }

  .testimonials__rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 24px;
  }

  .testimonials__laurel-wrapper {
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .testimonials__laurel-wrapper--right {
    transform: scaleX(-1);
  }

  .testimonials__laurel-img {
    height: 100%;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .testimonials__laurel {
    height: 40px;
    width: auto;
    color: var(--color-accent);
    line-height: 1;
    display: inline-block;
  }

  .testimonials__rating-image-wrapper {
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .testimonials__rating-image {
    height: 100%;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .testimonials__rating-content {
    text-align: left;
  }

  .testimonials__rating-stars {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  .testimonials__rating-number {
    font-family: var(--font-helvetica-world);
    font-size: 24px;
    font-weight: 700;
    color: var(--color-accent);
  }

  .testimonials__stars {
    color: var(--color-accent);
    font-size: 16px;
    letter-spacing: 2px;
  }

  .testimonials__rating-text {
    font-family: var(--font-helvetica-world);
    font-size: 14px;
    color: var(--color-fg-muted);
    margin: 0;
  }

  .testimonials__grid {
    column-count: 3;
    column-gap: 10px;
    margin-bottom: 40px;
  }

  .testimonials__more {
    column-count: 3;
    column-gap: 10px;
    margin-bottom: 40px;
  }

  .testimonial-card {
    background: #fff;
    padding: 28px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 10px;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .testimonial-card__stars {
    color: var(--color-accent);
    font-size: 13px;
    letter-spacing: 1px;
    margin-bottom: 4px;
  }

  .testimonial-card__title {
    font-family: var(--font-helvetica-world);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-fg);
    margin: 0;
    line-height: 1.4;
  }

  .testimonial-card__text {
    font-family: var(--font-helixa);
    font-size: 13px;
    color: var(--color-fg-muted);
    line-height: 1.6;
    margin: 0;
  }

  .testimonial-card__author {
    font-family: var(--font-helixa);
    font-size: 12px;
    color: var(--color-fg-muted);
    margin-top: 8px;
  }

  .testimonials__load-more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 0 auto;
    padding: 16px 40px;
    background: var(--color-bg);
    border: 1px solid var(--color-accent);
    border-radius: 100px;
    font-family: var(--font-helvetica-world);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-accent);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .testimonials__load-more:hover {
    background: var(--color-accent-solid);
    color: #fff;
    border-color: var(--color-accent-solid);
  }

  .testimonials__load-more svg {
    transition: transform 0.3s ease;
    width: 14px;
    height: 14px;
  }

  .testimonials__load-more.is-expanded svg {
    transform: rotate(180deg);
  }

  @media (max-width: 992px) {
    .testimonials__grid,
    .testimonials__more {
      column-count: 2;
    }
  }

  @media (max-width: 768px) {
    .testimonials-section {
      padding: 60px 24px;
    }

    .testimonials__grid,
    .testimonials__more {
      column-count: 1;
    }
  }
</style>

<script>
  (function() {
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;
    
    const loadMoreBtn = section.querySelector('[data-load-more]');
    const moreContainer = section.querySelector('[data-testimonials-more]');
    
    if (loadMoreBtn && moreContainer) {
      loadMoreBtn.addEventListener('click', function() {
        if (moreContainer.style.display === 'none') {
          moreContainer.style.display = 'grid';
          loadMoreBtn.querySelector('span').textContent = 'VIEW LESS';
          loadMoreBtn.classList.add('is-expanded');
        } else {
          moreContainer.style.display = 'none';
          loadMoreBtn.querySelector('span').textContent = 'VIEW MORE';
          loadMoreBtn.classList.remove('is-expanded');
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Testimonials Masonry",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "OUR CLIENTS SAYS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Únete a miles de personas que han transformado su ecommerce con Convert"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating number",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "Based on real customer reviews"
    },
    {
      "type": "header",
      "content": "Rating Image"
    },
    {
      "type": "image_picker",
      "id": "rating_image",
      "label": "Imagen del rating (reemplaza número + estrellas + texto)"
    },
    {
      "type": "range",
      "id": "rating_image_height",
      "label": "Alto de la imagen del rating",
      "min": 30,
      "max": 150,
      "step": 5,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Laurel/Hojas decorativas"
    },
    {
      "type": "image_picker",
      "id": "laurel_left",
      "label": "Imagen de laurel izquierda"
    },
    {
      "type": "image_picker",
      "id": "laurel_right",
      "label": "Imagen de laurel derecha"
    },
    {
      "type": "range",
      "id": "laurel_height",
      "label": "Alto de las imágenes de laurel",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Testimonial title",
          "default": "¡Por fin encontré la app de finanzas perfecta!"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Testimonial text",
          "default": "He probado muchas aplicaciones de finanzas personales..."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "María"
        },
        {
          "type": "select",
          "id": "rating",
          "label": "Rating",
          "options": [
            { "value": "5", "label": "5 stars" },
            { "value": "4", "label": "4 stars" },
            { "value": "3", "label": "3 stars" }
          ],
          "default": "5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials Masonry"
    }
  ]
}
{% endschema %}
