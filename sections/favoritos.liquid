<section class="favoritos-section" data-section-id="{{ section.id }}">
  <div class="favoritos__container">
    <div class="favoritos__header">
      <h1 class="favoritos__title">{{ section.settings.title | default: 'My Favorites' }}</h1>
      {% if section.settings.subtitle != blank %}
        <p class="favoritos__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="favoritos__grid" data-favoritos-grid>
      {% comment %} Los productos se cargan dinámicamente via JavaScript {% endcomment %}
    </div>

    <div class="favoritos__empty" data-favoritos-empty style="display: none;">
      <div class="favoritos__empty-icon">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </div>
      <h2 class="favoritos__empty-title">{{ section.settings.empty_title | default: 'No favorites yet' }}</h2>
      <p class="favoritos__empty-text">{{ section.settings.empty_text | default: 'Start adding products you love to your favorites list.' }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="favoritos__empty-btn">
        {{ section.settings.empty_button | default: 'Explore Products' }}
      </a>
    </div>
  </div>
</section>

<style>
  .favoritos-section {
    padding: 120px 24px 100px;
    background: #FDFBF5;
    min-height: 60vh;
  }

  .favoritos__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .favoritos__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .favoritos__title {
    font-family: var(--font-helvetica-world);
    font-size: clamp(32px, 5vw, 48px);
    color: var(--color-title-dark, #6B550E);
    text-transform: uppercase;
    margin: 0 0 16px 0;
    letter-spacing: -4px;
  }

  .favoritos__subtitle {
    font-family: var(--font-helvetica-world);
    font-size: 16px;
    color: var(--color-paragraph-dark, #6D6C6C);
    margin: 0;
  }

  .favoritos__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 990px) {
    .favoritos__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 550px) {
    .favoritos__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .favoritos__item {
    background: transparent;
  }

  .favoritos__item-image-wrapper {
    position: relative;
    aspect-ratio: 4 / 5;
    background: #e8e4d9;
    overflow: hidden;
    border-radius: 4px;
  }

  .favoritos__item-category {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.95);
    font-family: var(--font-helvetica-world);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-title-dark, #6B550E);
    border-radius: 2px;
  }

  .favoritos__item-remove {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    width: 36px;
    height: 36px;
    background: #fff;
    border: none;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-title-dark, #6B550E);
    transition: all 0.3s ease;
  }

  .favoritos__item-remove:hover {
    background: #c44;
    color: #fff;
  }

  .favoritos__item-remove.is-active svg {
    fill: currentColor;
  }

  .favoritos__item-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .favoritos__item-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .favoritos__item:hover .favoritos__item-image {
    transform: scale(1.05);
  }

  .favoritos__item-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e8e4d9 0%, #d4d0c5 100%);
  }

  .favoritos__item-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
  }

  .favoritos__item-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .favoritos__item-name {
    font-family: var(--font-helvetica-world);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-title-dark, #6B550E);
    margin: 0;
  }

  .favoritos__item-price {
    font-family: var(--font-helixa);
    font-size: 14px;
    color: var(--color-paragraph-dark, #6D6C6C);
  }

  .favoritos__item-add {
    padding: 10px 20px;
    background: #fff;
    border: 1px solid rgba(107, 85, 14, 0.15);
    border-radius: 6px;
    font-family: var(--font-helvetica-world);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-title-dark, #6B550E);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .favoritos__item-add:hover {
    background: var(--color-title-dark, #6B550E);
    color: #fff;
    border-color: var(--color-title-dark, #6B550E);
  }

  /* Empty State */
  .favoritos__empty {
    text-align: center;
    padding: 80px 24px;
  }

  .favoritos__empty-icon {
    color: rgba(107, 85, 14, 0.3);
    margin-bottom: 24px;
  }

  .favoritos__empty-title {
    font-family: var(--font-helvetica-world);
    font-size: 24px;
    font-weight: 500;
    color: var(--color-title-dark, #6B550E);
    margin: 0 0 12px 0;
  }

  .favoritos__empty-text {
    font-family: var(--font-helixa);
    font-size: 15px;
    color: var(--color-paragraph-dark, #6D6C6C);
    margin: 0 0 32px 0;
  }

  .favoritos__empty-btn {
    display: inline-block;
    padding: 16px 40px;
    background: var(--color-title-dark, #6B550E);
    color: #fff;
    border-radius: 1000px;
    font-family: var(--font-helvetica-world);
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .favoritos__empty-btn:hover {
    background: #5a480c;
    transform: translateY(-2px);
  }

  .favoritos__loading {
    text-align: center;
    padding: 60px 24px;
    font-family: var(--font-helixa);
    color: var(--color-paragraph-dark, #6D6C6C);
  }
</style>

<script>
  (function() {
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;
    
    const grid = section.querySelector('[data-favoritos-grid]');
    const empty = section.querySelector('[data-favoritos-empty]');
    
    // Get wishlist from localStorage
    function getWishlist() {
      try {
        const stored = localStorage.getItem('serenity_wishlist');
        return stored ? JSON.parse(stored) : [];
      } catch (e) {
        return [];
      }
    }
    
    function saveWishlist(wishlist) {
      localStorage.setItem('serenity_wishlist', JSON.stringify(wishlist));
      // Update header count
      const headerCount = document.querySelector('[data-wishlist-count]');
      if (headerCount) {
        headerCount.textContent = wishlist.length;
        headerCount.style.display = wishlist.length > 0 ? 'flex' : 'none';
      }
    }
    
    async function loadFavoritos() {
      const wishlist = getWishlist();
      
      if (wishlist.length === 0) {
        grid.style.display = 'none';
        empty.style.display = 'block';
        return;
      }
      
      grid.innerHTML = '<div class="favoritos__loading">Loading...</div>';
      
      try {
        // Fetch products data
        const products = [];
        for (const productId of wishlist) {
          try {
            const response = await fetch(`/products/${productId}.js`);
            if (response.ok) {
              const product = await response.json();
              products.push(product);
            }
          } catch (e) {
            console.error('Error loading product:', productId);
          }
        }
        
        if (products.length === 0) {
          grid.style.display = 'none';
          empty.style.display = 'block';
          return;
        }
        
        // Render products
        grid.innerHTML = products.map(product => {
          const category = product.tags && product.tags[0] ? product.tags[0] : 'Candle';
          const image = product.featured_image || product.images[0];
          const variant = product.variants[0];
          
          return `
            <div class="favoritos__item" data-product-id="${product.id}">
              <div class="favoritos__item-image-wrapper">
                <span class="favoritos__item-category">${category.toUpperCase()}</span>
                <button class="favoritos__item-remove" data-remove data-product-id="${product.id}" aria-label="Remove from favorites">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                </button>
                <a href="${product.url}" class="favoritos__item-link">
                  ${image ? `<img src="${image}" alt="${product.title}" class="favoritos__item-image" loading="lazy">` : '<div class="favoritos__item-placeholder"></div>'}
                </a>
              </div>
              <div class="favoritos__item-info">
                <div class="favoritos__item-meta">
                  <h3 class="favoritos__item-name">${product.title}</h3>
                  <span class="favoritos__item-price">$${(variant.price / 100).toFixed(2)}</span>
                </div>
                ${variant.available ? `
                  <button class="favoritos__item-add" data-add-to-cart data-variant-id="${variant.id}">
                    ADD +
                  </button>
                ` : '<button class="favoritos__item-add" disabled>SOLD OUT</button>'}
              </div>
            </div>
          `;
        }).join('');
        
        // Add event listeners
        grid.querySelectorAll('[data-remove]').forEach(btn => {
          btn.addEventListener('click', function() {
            const productId = this.dataset.productId;
            let wishlist = getWishlist();
            wishlist = wishlist.filter(id => id !== productId);
            saveWishlist(wishlist);
            loadFavoritos(); // Reload
          });
        });
        
        grid.querySelectorAll('[data-add-to-cart]').forEach(btn => {
          btn.addEventListener('click', async function() {
            const variantId = this.dataset.variantId;
            const originalText = this.textContent;
            
            try {
              const response = await fetch('/cart/add.js', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                  items: [{ id: variantId, quantity: 1 }]
                })
              });
              
              if (response.ok) {
                this.textContent = 'ADDED!';
                // Update cart count
                const cartResponse = await fetch('/cart.js');
                const cart = await cartResponse.json();
                const cartCount = document.querySelector('[data-cart-count]');
                if (cartCount) {
                  cartCount.textContent = cart.item_count;
                  cartCount.style.display = cart.item_count > 0 ? 'flex' : 'none';
                }
              } else {
                this.textContent = 'ERROR';
              }
            } catch (e) {
              this.textContent = 'ERROR';
            }
            
            setTimeout(() => {
              this.textContent = originalText;
            }, 2000);
          });
        });
        
      } catch (error) {
        console.error('Error loading favoritos:', error);
        grid.innerHTML = '<div class="favoritos__loading">Error loading favorites</div>';
      }
    }
    
    // Load on page load
    loadFavoritos();
  })();
</script>

{% schema %}
{
  "name": "Favoritos",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "My Favorites"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Your saved items"
    },
    {
      "type": "header",
      "content": "Empty State"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Empty title",
      "default": "No favorites yet"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty text",
      "default": "Start adding products you love to your favorites list."
    },
    {
      "type": "text",
      "id": "empty_button",
      "label": "Empty button text",
      "default": "Explore Products"
    }
  ],
  "presets": [
    {
      "name": "Favoritos"
    }
  ]
}
{% endschema %}
