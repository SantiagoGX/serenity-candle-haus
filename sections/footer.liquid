{% comment %} sections/footer-serenity.liquid {% endcomment %}

<footer class="footer-serenity color-{{ section.settings.color_scheme }}">
  <div class="footer-container">
    
    {% comment %} Línea superior {% endcomment %}
    <div class="footer-top-border"></div>

    {% comment %} Links principales {% endcomment %}
    <div class="footer-grid">
      
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="footer-column" {{ block.shopify_attributes }}>
              {%- if block.settings.menu != blank -%}
                <h3 class="footer-heading helixa-font">{{ block.settings.heading | default: linklists[block.settings.menu].title }}</h3>
                <ul class="footer-links">
                  {%- for link in linklists[block.settings.menu].links -%}
                    <li><a href="{{ link.url }}" class="footer-link helixa-font">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- else -%}
                <h3 class="footer-heading helixa-font">{{ block.settings.heading | default: 'Menu' }}</h3>
                <ul class="footer-links">
                  <li><a href="#" class="footer-link helixa-font">Select a menu</a></li>
                </ul>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}

      {% comment %} NEWSLETTER {% endcomment %}
      <div class="footer-column footer-newsletter">
        {% if section.settings.newsletter_heading != blank %}
          <p class="newsletter-text helixa-font">
            {{ section.settings.newsletter_heading }}
          </p>
        {% endif %}

        {% form 'customer', class: 'newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="contact[accepts_marketing]" value="true">

          {% if form.posted_successfully? %}
            {% if section.settings.newsletter_success_message != blank %}
              <p class="newsletter-success helixa-font">
                {{ section.settings.newsletter_success_message }}
              </p>
            {% endif %}
          {% else %}
            <div class="newsletter-input-wrapper">
              <input
                type="email"
                name="contact[email]"
                class="newsletter-input helixa-font"
                placeholder="{{ section.settings.newsletter_placeholder }}"
                required
                aria-label="{{ section.settings.newsletter_placeholder | default: 'Email' }}"
              >
            </div>
            {% if form.errors %}
              <p class="newsletter-error helixa-font">{{ form.errors.messages['email'] | default: 'Please enter a valid email.' }}</p>
            {% endif %}
            <button type="submit" class="newsletter-btn helixa-font">
              {{ section.settings.newsletter_button_text | default: 'JOIN' }}
            </button>
          {% endif %}
        {% endform %}
      </div>

    </div>

    {% comment %} Barra inferior {% endcomment %}
    <div class="footer-bottom">
      <div class="footer-credits">
        {% if section.settings.agency_text != blank %}
          <span class="credits-text helixa-font">{{ section.settings.agency_text }}</span>
        {% endif %}
        {% if section.settings.agency_text != blank and section.settings.agency_brand != blank %}
          <span class="credits-line"></span>
        {% endif %}
        {% if section.settings.agency_brand != blank %}
          <a href="{{ section.settings.agency_url | default: '#' }}" class="credits-brand helixa-font" style="text-decoration: none; color: inherit;" target="_blank">{{ section.settings.agency_brand }}</a>
        {% endif %}
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" class="footer-social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </a>
        {% endif %}
      </div>

      <div class="footer-brand">
        <span class="footer-brand-text" style="font-size: {{ section.settings.brand_text_size | default: 28 }}px;">SERENITY. CANDLE HAUS</span>
      </div>

      <div class="footer-copyright">
        <span class="copyright-text helixa-font">All Rights Reserved | Serenity 2025</span>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer-serenity {
    background-color: {{ section.settings.background_color | default: '#FFFFFF' }};
    position: relative;
    overflow: hidden;
    padding-top: 60px;
  }

  .footer-container {
    max-width: 1512px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  /* Tipografías */
  .helixa-font {
    font-family: var(--font-helixa), -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--color-fg);
    margin: 0;
  }

  /* Línea superior */
  .footer-top-border {
    width: 100%;
    height: 1px;
    background-color: rgba(0, 0, 0, 0.08);
    margin-bottom: 50px;
  }

  /* Grid principal - 5 columnas */
  .footer-grid {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 60px;
  }
  
  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
    flex: 1;
  }
  
  .footer-column--wide {
    flex: 1.5;
    min-width: 200px;
  }

  .footer-newsletter {
    flex: 1.2;
    min-width: 280px;
    max-width: 360px;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      flex-wrap: wrap;
      gap: 40px;
    }
    
    .footer-column {
      flex: 1 1 calc(33.333% - 30px);
      min-width: 150px;
    }
    
    .footer-column--wide {
      flex: 1 1 calc(50% - 20px);
    }
    
    .footer-newsletter {
      flex: 1 1 100%;
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .footer-container {
      padding: 0 24px;
    }
    
    .footer-grid {
      gap: 30px;
    }
    
    .footer-column,
    .footer-column--wide {
      flex: 1 1 calc(50% - 15px);
      min-width: 140px;
    }
    
    .footer-bottom {
      flex-direction: column;
      gap: 20px;
      text-align: center;
      margin-bottom: 40px;
    }
  }

  @media (max-width: 480px) {
    .footer-column,
    .footer-column--wide {
      flex: 1 1 100%;
    }
  }

  /* Columnas */
  .footer-heading {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--color-fg);
    margin: 0;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-link {
    font-size: 14px;
    color: var(--color-fg);
    text-decoration: none;
    transition: opacity 0.3s ease;
    opacity: 0.85;
    line-height: 1.4;
    white-space: nowrap;
  }

  .footer-link:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  /* Newsletter */
  .newsletter-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-fg);
    margin: 0;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .newsletter-input-wrapper {
    position: relative;
    width: 100%;
  }

  .newsletter-input {
    width: 100%;
    padding: 14px 20px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background-color: #FFFFFF;
    font-size: 14px;
    color: var(--color-fg);
    outline: none;
    transition: border-color 0.3s ease;
    box-sizing: border-box;
  }

  .newsletter-input::placeholder {
    color: var(--color-fg-muted);
  }

  .newsletter-input:focus {
    border-color: var(--color-accent);
  }

  .newsletter-btn {
    width: 100%;
    padding: 14px 24px;
    background-color: var(--color-accent-solid);
    color: #FFFFFF;
    border: 1px solid var(--color-accent-solid);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .newsletter-btn:hover {
    background-color: var(--color-accent-active);
    border-color: var(--color-accent-active);
    color: #FFFFFF;
  }

  .newsletter-success {
    font-size: 14px;
    color: var(--color-accent);
    line-height: 1.5;
  }

  .newsletter-error {
    font-size: 13px;
    color: #c0392b;
    margin: -4px 0 0;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--color-fg);
    opacity: 0.7;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .footer-social-link:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  /* Barra inferior */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30px 0;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .footer-credits {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
  }

  .credits-text {
    font-size: 13px;
    color: var(--color-fg);
    opacity: 0.7;
  }

  .credits-line {
    width: 40px;
    height: 1px;
    background-color: var(--color-fg);
    opacity: 0.3;
  }

  .credits-brand {
    font-size: 13px;
    color: var(--color-fg);
    font-weight: 500;
  }

  /* Brand name centered */
  .footer-brand {
    flex: 1;
    text-align: center;
  }

  .footer-brand-text {
    font-family: var(--font-helvetica-world), Arial, sans-serif;
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--color-fg);
    text-transform: uppercase;
  }

  /* Copyright right */
  .footer-copyright {
    flex: 1;
    text-align: right;
  }

  .copyright-text {
    font-size: 13px;
    color: var(--color-fg);
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .footer-bottom {
      flex-direction: column;
      gap: 24px;
      text-align: center;
    }
    
    .footer-credits,
    .footer-brand,
    .footer-copyright {
      flex: none;
      text-align: center;
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Footer Serenity",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "textarea",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join Serenity's newsletter for exclusive discounts and first access to new drops."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email field placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_button_text",
      "label": "Button text",
      "default": "JOIN"
    },
    {
      "type": "text",
      "id": "newsletter_success_message",
      "label": "Success message",
      "default": "Thanks for joining! Check your inbox soon."
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL",
      "info": "Leave blank to hide the icon"
    },
    {
      "type": "header",
      "content": "Brand Name"
    },
    {
      "type": "range",
      "id": "brand_text_size",
      "label": "Brand name size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Agency Branding"
    },
    {
      "type": "text",
      "id": "agency_text",
      "label": "Agency Prefix Text",
      "default": "Crafted with love by"
    },
    {
      "type": "text",
      "id": "agency_brand",
      "label": "Agency Brand Name",
      "default": "SNC Designs"
    },
    {
      "type": "url",
      "id": "agency_url",
      "label": "Agency URL"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Leave blank to use linklist title"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Serenity"
    }
  ]
}
{% endschema %}
