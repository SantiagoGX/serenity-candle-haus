{% form 'contact', id: 'ContactForm' %}
  <section class="contact-form-section" data-section-id="{{ section.id }}">
    <div class="contact-form__container">
      <div class="contact-form__header">
        <h2 class="contact-form__title">{{ section.settings.title | default: '¡Queremos Escucharte!' }}</h2>
        {% if section.settings.subtitle != blank %}
          <p class="contact-form__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>

      {% if form.posted_successfully? %}
        <div class="contact-form__success">
          {{ section.settings.success_message | default: '¡Gracias por tu mensaje! Te responderemos pronto.' }}
        </div>
      {% endif %}

      <div class="contact-form__fields">
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="ContactFormName" class="contact-form__label">{{ section.settings.name_label | default: 'Name' }}</label>
            <input 
              type="text" 
              id="ContactFormName" 
              name="contact[name]" 
              class="contact-form__input"
              value="{% if form.name %}{{ form.name }}{% endif %}"
              required
            >
          </div>
          <div class="contact-form__field">
            <label for="ContactFormEmail" class="contact-form__label">{{ section.settings.email_label | default: 'Email' }}</label>
            <input 
              type="email" 
              id="ContactFormEmail" 
              name="contact[email]" 
              class="contact-form__input"
              value="{% if form.email %}{{ form.email }}{% endif %}"
              required
            >
          </div>
        </div>

        <div class="contact-form__field">
          <label for="ContactFormMessage" class="contact-form__label">{{ section.settings.message_label | default: 'Message' }}</label>
          <textarea 
            id="ContactFormMessage" 
            name="contact[body]" 
            class="contact-form__textarea"
            rows="6"
            required
          >{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>

        <div class="contact-form__submit-wrapper">
          <button type="submit" class="contact-form__submit">
            {{ section.settings.submit_label | default: 'Send' }}
          </button>
        </div>
      </div>

      <div class="contact-form__info">
        <div class="contact-form__info-item">
          <span class="contact-form__info-label">{{ section.settings.contact_label | default: 'Contact Us' }}</span>
          <a href="mailto:{{ section.settings.email | default: 'info@delevilie.com' }}" class="contact-form__info-value">
            {{ section.settings.email | default: 'info@delevilie.com' }}
          </a>
        </div>
        <div class="contact-form__info-item">
          <span class="contact-form__info-label">{{ section.settings.weekdays_label | default: 'Monday - Friday' }}</span>
          <span class="contact-form__info-value">{{ section.settings.weekdays_hours | default: '10:00 am — 7:00 pm' }}</span>
        </div>
        <div class="contact-form__info-item">
          <span class="contact-form__info-label">{{ section.settings.saturday_label | default: 'Saturday' }}</span>
          <span class="contact-form__info-value">{{ section.settings.saturday_hours | default: '10:00 am — 2:00 pm' }}</span>
        </div>
      </div>
    </div>
  </section>
{% endform %}

<style>
  .contact-form-section {
    padding: 80px 24px;
    background: #FAFAF8;
  }

  .contact-form__container {
    max-width: 700px;
    margin: 0 auto;
  }

  .contact-form__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .contact-form__title {
    font-family: var(--font-helvetica-world);
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 16px 0;
    text-transform: uppercase;
    letter-spacing: -4px;
  }

  .contact-form__subtitle {
    font-family: var(--font-helvetica-world);
    font-size: 15px;
    color: #666;
    line-height: 1.6;
    margin: 0;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  .contact-form__success {
    background: #e8f5e9;
    color: #2e7d32;
    padding: 16px 24px;
    border-radius: 8px;
    margin-bottom: 32px;
    text-align: center;
    font-family: var(--font-helvetica-world);
    font-size: 14px;
  }

  .contact-form__fields {
    margin-bottom: 48px;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .contact-form__field {
    margin-bottom: 16px;
  }

  .contact-form__label {
    display: block;
    font-family: var(--font-helvetica-world);
    font-size: 13px;
    font-weight: 500;
    color: #1a1a1a;
    margin-bottom: 8px;
  }

  .contact-form__input,
  .contact-form__textarea {
    width: 100%;
    padding: 16px;
    background: #F5F5F3;
    border: none;
    border-radius: 8px;
    font-family: var(--font-helvetica-world);
    font-size: 14px;
    color: #1a1a1a;
    outline: none;
    transition: background 0.3s ease;
  }

  .contact-form__input:focus,
  .contact-form__textarea:focus {
    background: #eeeeec;
  }

  .contact-form__textarea {
    resize: vertical;
    min-height: 140px;
  }

  .contact-form__submit-wrapper {
    display: flex;
    justify-content: flex-end;
    margin-top: 24px;
  }

  .contact-form__submit {
    padding: 14px 48px;
    background: #6B550E;
    color: #fff;
    border: none;
    border-radius: 100px;
    font-family: var(--font-helvetica-world);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .contact-form__submit:hover {
    background: #5a480c;
    transform: translateY(-2px);
  }

  .contact-form__info {
    display: flex;
    justify-content: center;
    gap: 48px;
    padding: 32px;
    background: #F5F5F3;
    border-radius: 12px;
    flex-wrap: wrap;
  }

  .contact-form__info-item {
    text-align: center;
  }

  .contact-form__info-label {
    display: block;
    font-family: var(--font-helvetica-world);
    font-size: 12px;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }

  .contact-form__info-value {
    font-family: var(--font-helixa);
    font-size: 15px;
    color: #1a1a1a;
    font-weight: 500;
    text-decoration: none;
  }

  .contact-form__info-value:hover {
    color: #6B550E;
  }

  @media (max-width: 768px) {
    .contact-form-section {
      padding: 60px 24px;
    }

    .contact-form__row {
      grid-template-columns: 1fr;
    }

    .contact-form__submit-wrapper {
      justify-content: center;
    }

    .contact-form__submit {
      width: 100%;
    }

    .contact-form__info {
      flex-direction: column;
      gap: 24px;
    }
  }
</style>

