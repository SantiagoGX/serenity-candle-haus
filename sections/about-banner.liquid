{% assign background_image = section.settings.background_image %}

<section class="about-banner" data-section-id="{{ section.id }}" style="{% if background_image %}background-image: url('{{ background_image | image_url: width: 2000 }}');{% endif %}">
  <div class="about-banner__overlay" style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  
  <div class="about-banner__content">
    <div class="about-banner__main">
      <h2 class="about-banner__title">{{ section.settings.title | default: 'ABOUT ME' }}</h2>
      <div class="about-banner__divider"></div>
    </div>
    
    <div class="about-banner__text">
      <p>{{ section.settings.description | default: 'Lorem ipsum dolor sit amet consectetur. Tellus dignissim eu a odio. Nisl tristique nunc et nibh aliquet et elementum enim in.' }}</p>
    </div>
  </div>
</section>

<style>
  .about-banner {
    position: relative;
    min-height: 100vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: flex-end;
    padding: 60px 80px;
  }
  
  .about-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  
  .about-banner__content {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
  }
  
  .about-banner__main {
    flex: 1;
  }
  
  .about-banner__title {
    font-family: var(--font-helvetica-world);
    font-size: clamp(48px, 6vw, 72px);
    color: #fff;
    text-transform: uppercase;
    letter-spacing: -4px;
    line-height: 1;
    margin: 0 0 24px 0;
    letter-spacing: 2px;
  }
  
  .about-banner__divider {
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.4);
  }
  
  .about-banner__text {
    flex: 0 0 380px;
    max-width: 400px;
  }
  
  .about-banner__text p {
    font-family: var(--font-helixa);
    font-size: 17px;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.5;
    margin: 0;
    font-weight: 600;
  }
  
  @media (max-width: 992px) {
    .about-banner {
      padding: 40px;
    }
    
    .about-banner__content {
      flex-direction: column;
      align-items: flex-start;
      gap: 30px;
    }
    
    .about-banner__text {
      flex: 0 0 auto;
      max-width: 100%;
    }
  }
  
  @media (max-width: 768px) {
    .about-banner {
      padding: 30px 24px;
      min-height: 80vh;
    }
    
    .about-banner__title {
      font-size: 40px;
    }
    
    .about-banner__text p {
      font-size: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "About Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "ABOUT ME"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Lorem ipsum dolor sit amet consectetur. Tellus dignissim eu a odio. Nisl tristique nunc et nibh aliquet et elementum enim in."
    }
  ],
  "presets": [
    {
      "name": "About Banner"
    }
  ]
}
{% endschema %}
