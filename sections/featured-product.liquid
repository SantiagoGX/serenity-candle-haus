{% comment %} sections/featured-product-custom.liquid - CORREGIDO {% endcomment %}

{{ 'section-featured-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign media_height = section.settings.media_height | default: 700
  assign media_type = section.settings.media_type | default: 'image'
  
  assign product = section.settings.product
  assign featured_media = product.featured_media | default: section.settings.image
  
  assign product_title = section.settings.heading | default: product.title | default: 'CUTE<br>CANDLE'
  assign product_price = section.settings.price | default: product.price
  assign product_compare_price = section.settings.compare_price | default: product.compare_at_price
  assign product_description = section.settings.description | default: product.description
  assign product_url = section.settings.button_url | default: product.url
-%}

<div 
  class="featured-product-section color-{{ section.settings.color_scheme }}" 
  style="--media-height: {{ media_height }}px; --bg-color: {{ section.settings.background_color | default: '#FAFAF8' }};"
>
  <div class="featured-product-container">
    <div class="featured-product-grid">
      
      {% comment %} Columna Izquierda: Info Principal {% endcomment %}
      <div class="product-info-left">
        <div class="product-info-content">
          <h1 class="product-title avigea-font">{{ product_title }}</h1>
          
          <p class="product-tagline helixa-font">{{ section.settings.tagline | default: "More than a Scent. It's a Ritual." }}</p>
          
          <div class="product-pricing helixa-font">
            {%- if product_compare_price != blank and product_compare_price != 0 -%}
              <span class="price-original">
                {%- if product != blank -%}
                  {{ product_compare_price | money }}
                {%- else -%}
                  {{ product_compare_price }}
                {%- endif -%}
              </span>
            {%- endif -%}
            
            {%- if product_price != blank -%}
              <span class="price-sale">
                {%- if product != blank -%}
                  {{ product_price | money }}
                {%- else -%}
                  {{ product_price }}
                {%- endif -%}
              </span>
            {%- else -%}
              <span class="price-original">$45.00</span>
              <span class="price-sale">$35.00</span>
            {%- endif -%}
          </div>
          
          {%- if product_compare_price > product_price and product != blank -%}
            {%- assign savings = product_compare_price | minus: product_price | times: 100 | divided_by: product_compare_price -%}
            <span class="discount-badge helixa-font">SAVE {{ savings }}%</span>
          {%- endif -%}
        </div>

        <div class="product-features">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'feature' -%}
                <div class="feature-item helixa-font" {{ block.shopify_attributes }}>
                  <span class="feature-icon">{{ block.settings.icon }}</span>
                  <span>{{ block.settings.text }}</span>
                </div>
            {%- endcase -%}
          {%- else -%}
            <div class="feature-item helixa-font">
              <span class="feature-icon">✿</span>
              <span>Ingredientes of superstars</span>
            </div>
            <div class="feature-item helixa-font">
              <span class="feature-icon">♥</span>
              <span>Smells coconut</span>
            </div>
            <div class="feature-item helixa-font">
              <span class="feature-icon">✦</span>
              <span>Looks very serenity</span>
            </div>
          {%- endfor -%}
        </div>
        
        {%- if section.settings.show_trust_badges -%}
          <div class="trust-badges">
            {%- if section.settings.trust_icon_1 != blank -%}
              <div class="trust-item">
                <span class="trust-icon">{{ section.settings.trust_icon_1 }}</span>
                <span class="trust-text helixa-font">{{ section.settings.trust_text_1 }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {% comment %} Columna Centro: Media (Imagen/Video) {% endcomment %}
      <div class="product-media-center">
        <div class="media-wrapper" style="height: {{ media_height }}px;">
          {%- if media_type == 'video' and section.settings.video != blank -%}
            <video 
              autoplay 
              loop 
              muted 
              playsinline
              poster="{{ section.settings.video.preview_image | img_url: 'master' }}"
              class="media-element"
            >
              {%- for source in section.settings.video.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- elsif featured_media != blank -%}
            {%- if product != blank -%}
              <img 
                srcset="{%- if featured_media.width >= 375 -%}{{ featured_media | img_url: '375x' }} 375w,{%- endif -%}
                        {%- if featured_media.width >= 550 -%}{{ featured_media | img_url: '550x' }} 550w,{%- endif -%}
                        {%- if featured_media.width >= 750 -%}{{ featured_media | img_url: '750x' }} 750w,{%- endif -%}
                        {%- if featured_media.width >= 1100 -%}{{ featured_media | img_url: '1100x' }} 1100w,{%- endif -%}
                        {%- if featured_media.width >= 1500 -%}{{ featured_media | img_url: '1500x' }} 1500w,{%- endif -%}
                        {{ featured_media | img_url: 'master' }} {{ featured_media.width }}w"
                src="{{ featured_media | img_url: '1500x' }}"
                sizes="(min-width: 990px) 40vw, 100vw"
                alt="{{ featured_media.alt | escape }}"
                loading="lazy"
                class="media-element"
                width="{{ featured_media.width }}"
                height="{{ featured_media.height }}"
              >
            {%- else -%}
              <img 
                src="{{ featured_media | img_url: 'master' }}" 
                alt="{{ featured_media.alt | escape }}"
                loading="lazy"
                class="media-element"
                width="{{ featured_media.width }}"
                height="{{ featured_media.height }}"
              >
            {%- endif -%}
          {%- else -%}
            <div class="media-placeholder">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
          
          {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
            <div class="media-badge helixa-font">{{ section.settings.badge_text }}</div>
          {%- endif -%}
        </div>
      </div>

      {% comment %} Columna Derecha: Descripción y CTA {% endcomment %}
      <div class="product-description-right">
        <div class="description-content helixa-font">
          {%- if product_description != blank -%}
            {{ product_description | truncatewords: 60 }}
          {%- else -%}
            <p>Lorem ipsum dolor sit amet consectetur. Tellus dignissim eu a odio. Nisl tristique nunc et nibh aliquet et elementum enim in.</p>
            <p>Lorem ipsum dolor sit amet consectetur. Tellus dignissim eu a odio.</p>
          {%- endif -%}
        </div>
        
        {%- if product != blank and product.variants.size > 1 and section.settings.show_variant_selector -%}
          <div class="variant-selector">
            <label class="variant-label helixa-font">{{ section.settings.variant_label_text | default: 'Select Size:' }}</label>
            <div class="variant-options">
              {%- for variant in product.variants limit: 3 -%}
                <button type="button" class="variant-btn helixa-font" data-variant-id="{{ variant.id }}">
                  {{ variant.title }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
        
        <div class="button-group">
          {%- if product != blank -%}
            <button 
              type="button" 
              class="btn-cta btn-primary helixa-font add-to-cart-btn" 
              data-product-id="{{ product.id }}"
              data-variant-id="{{ product.first_available_variant.id }}"
              {% unless product.available %}disabled{% endunless %}
            >
              {%- if product.available -%}
                {{ section.settings.button_text | default: 'ADD TO CART' }}
              {%- else -%}
                {{ section.settings.out_of_stock_text | default: 'SOLD OUT' }}
              {%- endif -%}
            </button>
          {%- endif -%}
          
          <a href="{{ section.settings.secondary_button_url | default: product_url | default: '#' }}" class="btn-cta btn-secondary helixa-font">
            {{ section.settings.secondary_button_text | default: 'VIEW PRODUCT' }}
          </a>
        </div>
        
        {%- if section.settings.show_shipping_info -%}
          <p class="shipping-info helixa-font">
            {{ section.settings.shipping_text | default: '<span class="shipping-icon">🚚</span> Free shipping on orders over $50' }}
          </p>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

<style>

  .featured-product-section {
    width: 100%;
    background-color: var(--bg-color, #FAFAF8);
    position: relative;
  }

  .featured-product-container {
    max-width: 1512px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    box-sizing: border-box;
  }

  .featured-product-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    gap: 60px;
    min-height: var(--media-height);
    align-items: stretch;
    padding: 100px 0;
  }

  /* Tipografías */
  .avigea-font {
    font-family: 'Helvetica World', Arial, sans-serif;
    color: #6B550E;
    margin: 0;
    font-weight: 700;
  }

  .helixa-font {
    font-family: 'Helvetica World', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: #6D6C6C;
    margin: 0;
  }

  /* Columna Izquierda */
  .product-info-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: 40px 0;
  }

  .product-info-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .product-title {
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-weight: 400;
  }

  .product-tagline {
    font-size: 1.1rem;
    font-style: italic;
    color: #6B550E;
    opacity: 0.8;
    margin-top: 8px;
  }

  .product-pricing {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 1.2rem;
    margin-top: 20px;
  }

  .price-original {
    text-decoration: line-through;
    opacity: 0.5;
    color: #6D6C6C;
    font-size: 1.1rem;
  }

  .price-sale {
    color: #6B550E;
    font-weight: 500;
    font-size: 1.4rem;
  }

  .discount-badge {
    display: inline-block;
    background-color: #6B550E;
    color: #FFFFFF;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    margin-left: 8px;
    letter-spacing: 0.05em;
  }

  /* Features con divisores */
  .product-features {
    display: flex;
    flex-direction: column;
    margin-top: 40px;
    border-top: 1px solid rgba(107, 85, 14, 0.15);
    padding-top: 30px;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 0.95rem;
    color: #6D6C6C;
    padding: 16px 0;
    border-bottom: 1px solid rgba(107, 85, 14, 0.1);
  }

  .feature-item:last-child {
    border-bottom: none;
  }

  .feature-icon {
    color: #6B550E;
    font-size: 1.2rem;
    width: 24px;
    display: inline-flex;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Trust Badges */
  .trust-badges {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid rgba(107, 85, 14, 0.1);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: #6B550E;
    opacity: 0.8;
  }

  .trust-icon {
    font-size: 1.1rem;
  }

  /* Columna Centro - Media */
  .product-media-center {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .media-wrapper {
    position: relative;
    width: 100%;
    height: var(--media-height);
    overflow: hidden;
    background-color: #F0ECDF;
  }

  .media-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .media-wrapper:hover .media-element {
    transform: scale(1.02);
  }

  .media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #F0ECDF;
  }

  .media-placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .media-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    background-color: #FFFFFF;
    color: #6B550E;
    padding: 8px 16px;
    border-radius: 1000px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    z-index: 2;
  }

  /* Columna Derecha */
  .product-description-right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    gap: 30px;
    padding: 40px 0;
    padding-left: 40px;
  }

  .description-content {
    line-height: 1.8;
    font-size: 1rem;
    color: #6D6C6C;
  }

  .description-content p {
    margin: 0 0 1.5em 0;
  }

  .description-content p:last-child {
    margin-bottom: 0;
  }

  /* Selector de variantes */
  .variant-selector {
    margin: 10px 0;
  }

  .variant-label {
    display: block;
    font-size: 0.85rem;
    margin-bottom: 12px;
    color: #6B550E;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .variant-options {
    display: flex;
    gap: 10px;
  }

  .variant-btn {
    padding: 10px 20px;
    border: 1px solid rgba(107, 85, 14, 0.2);
    background: #FFFFFF;
    color: #6B550E;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.3s ease;
  }

  .variant-btn:hover,
  .variant-btn.active {
    background: #6B550E;
    color: #FFFFFF;
    border-color: #6B550E;
  }

  /* Grupo de botones */
  .button-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 10px;
  }

  /* Botones según Design System */
  .btn-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(107, 85, 14, 0.2);
    border-radius: 1000px;
    padding: 25px 35px;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
    text-align: center;
  }

  .btn-primary {
    background-color: #F0ECDF;
    color: #6B550E;
  }

  .btn-primary:hover:not(:disabled) {
    background-color: #6B550E;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(107, 85, 14, 0.15);
  }

  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-secondary {
    background-color: #FFFFFF;
    color: #6B550E;
  }

  .btn-secondary:hover {
    background-color: #F0ECDF;
    transform: translateY(-2px);
  }

  /* Info de envío */
  .shipping-info {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: #6B550E;
    opacity: 0.8;
    margin-top: 10px;
  }

  .shipping-icon {
    font-size: 1.1rem;
  }

  /* Responsive */
  @media screen and (max-width: 1024px) {
    .featured-product-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      min-height: auto;
      padding: 60px 0;
    }
    
    .product-media-center {
      order: -1;
    }
    
    .media-wrapper {
      height: 500px;
      max-width: 600px;
      margin: 0 auto;
    }
    
    .product-info-left,
    .product-description-right {
      padding: 0;
      text-align: center;
      max-width: 600px;
      margin: 0 auto;
    }
    
    .product-description-right {
      padding-left: 0;
    }

    .product-features {
      align-items: center;
    }

    .feature-item {
      justify-content: center;
    }

    .button-group {
      max-width: 400px;
      margin: 0 auto;
      width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .featured-product-container {
      padding: 0 20px;
    }
    
    .media-wrapper {
      height: 400px;
    }
    
    .product-title {
      font-size: 2.5rem;
    }

    .btn-cta {
      padding: 20px 30px;
    }

    .featured-product-grid {
      padding: 40px 0;
    }

    .product-info-content {
      gap: 12px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Add to cart functionality
    const addToCartBtns = document.querySelectorAll('.add-to-cart-btn');
    
    addToCartBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (btn.disabled) return;
        
        const variantId = btn.dataset.variantId;
        const originalText = btn.textContent;
        
        btn.disabled = true;
        btn.textContent = 'ADDING...';
        
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({
            items: [{
              id: variantId,
              quantity: 1
            }]
          })
        })
        .then(function(response) { return response.json(); })
        .then(function() {
          btn.textContent = 'ADDED!';
          btn.style.backgroundColor = '#6B550E';
          btn.style.color = '#FFFFFF';
          
          setTimeout(function() {
            btn.textContent = originalText;
            btn.disabled = false;
            btn.style.backgroundColor = '';
            btn.style.color = '';
          }, 2000);
          
          // Update cart count in header if exists
          return fetch('/cart.js');
        })
        .then(function(response) { return response.json(); })
        .then(function(cart) {
          const cartCount = document.querySelector('[data-cart-count]');
          if (cartCount) {
            cartCount.textContent = cart.item_count;
            cartCount.style.display = cart.item_count > 0 ? 'flex' : 'none';
          }
        })
        .catch(function(error) {
          console.error('Error:', error);
          btn.textContent = 'ERROR';
          setTimeout(function() {
            btn.textContent = originalText;
            btn.disabled = false;
          }, 2000);
        });
      });
    });

    // Variant selector
    const variantBtns = document.querySelectorAll('.variant-btn');
    variantBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        variantBtns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        
        // Update add to cart button variant id
        const addToCartBtn = document.querySelector('.add-to-cart-btn');
        if (addToCartBtn) {
          addToCartBtn.dataset.variantId = btn.dataset.variantId;
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Featured Product Custom",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Product Selection"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Select Product",
      "info": "Select a product to display its real data, or leave empty to use custom content below"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FAFAF8"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "inverse", "label": "Inverse" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "media_height",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Media Height",
      "default": 700,
      "info": "Height of the center image/video"
    },
    {
      "type": "header",
      "content": "Media Settings"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type (fallback)",
      "info": "Used only if no product is selected",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom Image",
      "info": "Fallback image if no product selected"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Custom Video"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Badge",
      "default": false
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "NEW"
    },
    {
      "type": "header",
      "content": "Content Overrides"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Custom Heading",
      "info": "Overrides product title. Use <br> for line breaks."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "More than a Scent. It's a Ritual."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Custom Description",
      "info": "Overrides product description."
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Custom Compare Price",
      "info": "E.g. $45.00"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Custom Price",
      "info": "E.g. $35.00"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Primary Button Text",
      "default": "ADD TO CART",
      "info": "Shown only when product is selected"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Text",
      "default": "VIEW PRODUCT"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL",
      "info": "Overrides product URL"
    },
    {
      "type": "checkbox",
      "id": "show_variant_selector",
      "label": "Show Variant Selector",
      "default": false,
      "info": "Show size/flavor options if product has variants"
    },
    {
      "type": "text",
