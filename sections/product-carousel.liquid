{% comment %} sections/product-carousel.liquid - CON CLONADO DE PRODUCTOS {% endcomment %}

{% assign products_to_show = section.settings.products_to_show | default: 8 %}
{% if products_to_show > 8 %}
  {% assign products_to_show = 8 %}
{% endif %}

{% assign collection_handle = section.settings.collection | default: 'all' %}
{% assign collection = collections[collection_handle] %}

<div class="product-carousel-section" data-section-id="{{ section.id }}">
  <div class="product-carousel__header-container">
    <div class="product-carousel__header">
      <h2 class="product-carousel__title">{{ section.settings.title | default: 'CANDLES' }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="product-carousel__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
      
      <div class="product-carousel__nav">
        <button class="product-carousel__arrow product-carousel__arrow--prev" aria-label="Previous products" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>
        <button class="product-carousel__arrow product-carousel__arrow--next" aria-label="Next products" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="product-carousel__wrapper">
    <div class="product-carousel__track" data-carousel-track role="list" aria-label="Product carousel">
      {% if collection and collection.products.size > 0 %}
        {% comment %} 
          CLONADO: Si hay menos productos que products_to_show, 
          se repiten/clonan los productos existentes usando modulo 
        {% endcomment %}
        {% assign available_products = collection.products %}
        {% assign product_count = available_products.size %}
        
        {% for i in (1..products_to_show) %}
          {% assign product_index = forloop.index0 | modulo: product_count %}
          {% assign product = available_products[product_index] %}
          {% assign product_category = product.collections.first.title | default: 'Candle' %}
          
          <div class="product-carousel__slide" role="listitem" tabindex="0">
            <div class="product-card-carousel">
              <div class="product-card-carousel__image-wrapper">
                <span class="product-card-carousel__category">{{ product_category | upcase }}</span>
                <button class="product-card-carousel__wishlist" data-wishlist-btn data-product-id="{{ product.id }}" aria-label="Add {{ product.title | escape }} to wishlist" type="button">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                </button>
                <a href="{{ product.url }}" class="product-card-carousel__link" aria-label="View {{ product.title | escape }}">
                  {% if product.featured_image %}
                    {{ product.featured_image | image_url: width: 800 | image_tag: 
                      loading: 'lazy',
                      class: 'product-card-carousel__image',
                      alt: product.featured_image.alt | default: product.title,
                      width: 600,
                      height: 750
                    }}
                  {% else %}
                    <div class="product-card-carousel__placeholder"></div>
                  {% endif %}
                </a>
              </div>
              <div class="product-card-carousel__info">
                <div class="product-card-carousel__meta">
                  <h3 class="product-card-carousel__name">{{ product.title }}</h3>
                  <span class="product-card-carousel__price">{{ product.price | money }}</span>
                </div>
                {% if product.first_available_variant and product.available %}
                  <button class="product-card-carousel__add-btn" 
                    data-add-to-cart 
                    data-product-id="{{ product.id }}" 
                    data-variant-id="{{ product.first_available_variant.id }}"
                    type="button">
                    ADD +
                  </button>
                {% else %}
                  <button class="product-card-carousel__add-btn product-card-carousel__add-btn--disabled" disabled type="button">
                    SOLD OUT
                  </button>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
        
      {% else %}
        {% comment %} Placeholders cuando no hay colección {% endcomment %}
        {% for i in (1..products_to_show) %}
          <div class="product-carousel__slide" role="listitem">
            <div class="product-card-carousel product-card-carousel--placeholder">
              <div class="product-card-carousel__image-wrapper">
                <span class="product-card-carousel__category">CANDLE</span>
                <button class="product-card-carousel__wishlist" aria-label="Add to wishlist" type="button">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                </button>
                <div class="product-card-carousel__placeholder">
                  <span class="placeholder-number">{{ forloop.index }}</span>
                </div>
              </div>
              <div class="product-card-carousel__info">
                <div class="product-card-carousel__meta">
                  <h3 class="product-card-carousel__name">Candle Product {{ forloop.index }}</h3>
                  <span class="product-card-carousel__price">$35.00</span>
                </div>
                <button class="product-card-carousel__add-btn" type="button">ADD +</button>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<style>
  .product-carousel-section {
    padding: 80px 0;
  background: var(--color-bg);
    overflow: hidden;
  }

  .product-carousel__header-container {
    max-width: 1512px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .product-carousel__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .product-carousel__title {
    font-family: var(--font-helvetica-world), Arial, sans-serif;
    font-size: 48px;
    color: var(--color-fg);
    text-transform: uppercase;
    letter-spacing: -4px;
    margin-bottom: 12px;
    letter-spacing: 2px;
  }

  .product-carousel__subtitle {
    font-family: 'Helvetica World', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 16px;
    color: var(--color-fg-muted);
    margin-bottom: 24px;
  }

  .product-carousel__nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
  }

  .product-carousel__arrow {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: #fff;
    border: 1px solid var(--color-accent-a15);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .product-carousel__arrow:hover:not(:disabled) {
    background: var(--color-accent-solid);
    color: #fff;
  }

  .product-carousel__arrow:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .product-carousel__arrow:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .product-carousel__wrapper {
    width: 100%;
    padding-left: 20px;
  }
  
  @media (min-width: 1552px) {
    .product-carousel__wrapper {
      padding-left: calc((100vw - 1512px) / 2 + 20px);
    }
  }

  .product-carousel__track {
    display: flex;
    gap: 16px;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
    padding-right: 20px;
  }

  .product-carousel__slide {
    flex: 0 0 calc((100vw - 20px - 16px * 3) / 3.4);
    min-width: 280px;
    outline: none;
  }

  .product-carousel__slide:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 768px) {
    .product-carousel__slide {
      flex: 0 0 calc((100vw - 20px - 16px) / 1.5);
      min-width: 240px;
    }
  }

  /* Product Card */
  .product-card-carousel {
    background: transparent;
  }

  .product-card-carousel__image-wrapper {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--color-border);
    overflow: hidden;
    border-radius: 4px;
  }

  .product-card-carousel__category {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.9);
    font-family: 'Helvetica World', sans-serif;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-accent);
    border-radius: 2px;
  }

  .product-card-carousel__wishlist {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    width: 36px;
    height: 36px;
    background: #fff;
    border: none;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-accent);
    transition: all 0.3s ease;
  }

  .product-card-carousel__wishlist:hover {
    background: var(--color-accent-solid);
    color: #fff;
  }

  .product-card-carousel__wishlist.is-active svg {
    fill: currentColor;
  }

  .product-card-carousel__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .product-card-carousel:hover .product-card-carousel__image {
    transform: scale(1.05);
  }

  .product-card-carousel__placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-number {
    font-family: 'Helvetica World', sans-serif;
    font-size: 48px;
    color: var(--color-accent);
    opacity: 0.3;
  }

  .product-card-carousel__info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
  }

  .product-card-carousel__meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .product-card-carousel__name {
    font-family: 'Helvetica World', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-fg);
    margin: 0;
  }

  .product-card-carousel__price {
    font-family: 'Helvetica World', sans-serif;
    font-size: 14px;
    color: var(--color-accent);
  }

  .product-card-carousel__add-btn {
    padding: 14px 26px;
    background: var(--color-bg);
    border: 1px solid var(--color-accent);
    border-radius: 6px;
    font-family: 'Helvetica World', sans-serif;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-accent);
    cursor: pointer;
    transition: all 0.3s ease;
    min-width: 90px;
  }

  .product-card-carousel__add-btn:hover:not(:disabled) {
    background: var(--color-accent-solid);
    border-color: var(--color-accent-solid);
    color: #fff;
  }

  .product-card-carousel__add-btn--disabled {
    opacity: 0.6;
    cursor: not-allowed;
    background: var(--color-border);
    border-color: var(--color-border);
    color: var(--color-fg-muted);
  }

  .product-card-carousel__add-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    const track = section.querySelector('[data-carousel-track]');
    const slides = section.querySelectorAll('.product-carousel__slide');
    const prevBtn = section.querySelector('.product-carousel__arrow--prev');
    const nextBtn = section.querySelector('.product-carousel__arrow--next');

    if (!track || slides.length === 0 || !prevBtn || !nextBtn) return;

    let currentIndex = 0;
    const gap = 16;
    let slideWidth = 0;
    let maxIndex = 0;
    let resizeTimeout;

    function calculateDimensions() {
      if (slides.length === 0) return;
      
      const wrapper = section.querySelector('.product-carousel__wrapper');
      const wrapperStyles = window.getComputedStyle(wrapper);
      const wrapperPaddingLeft = parseInt(wrapperStyles.paddingLeft) || 20;
      const wrapperWidth = wrapper.offsetWidth - wrapperPaddingLeft + 20;
      
      slideWidth = slides[0].offsetWidth + gap;
      
      if (slideWidth === 0 || slideWidth === gap) return;
      
      const visibleSlides = wrapperWidth / slideWidth;
      maxIndex = Math.max(0, Math.ceil(slides.length - visibleSlides));
      
      updateCarousel();
    }

    function updateCarousel() {
      currentIndex = Math.max(0, Math.min(currentIndex, maxIndex));
      
      const translateX = -(currentIndex * slideWidth);
      track.style.transform = 'translateX(' + translateX + 'px)';
      
      prevBtn.disabled = currentIndex === 0;
      nextBtn.disabled = currentIndex >= maxIndex;
      
      track.setAttribute('aria-live', 'polite');
    }

    prevBtn.addEventListener('click', function() {
      if (currentIndex > 0) {
        currentIndex--;
        updateCarousel();
        slides[currentIndex].focus();
      }
    });

    nextBtn.addEventListener('click', function() {
      if (currentIndex < maxIndex) {
        currentIndex++;
        updateCarousel();
        slides[currentIndex].focus();
      }
    });

    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(function() {
        calculateDimensions();
      }, 150);
    });

    section.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevBtn.click();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        nextBtn.click();
      }
    });

    calculateDimensions();

    // Wishlist functionality
    const wishlistBtns = section.querySelectorAll('[data-wishlist-btn]');
    
    function getWishlist() {
      try {
        const stored = localStorage.getItem('serenity_wishlist');
        return stored ? JSON.parse(stored) : [];
      } catch (e) {
        console.warn('LocalStorage not available:', e);
        return [];
      }
    }
    
    function saveWishlist(wishlist) {
      try {
        localStorage.setItem('serenity_wishlist', JSON.stringify(wishlist));
        return true;
      } catch (e) {
        console.warn('Could not save wishlist:', e);
        return false;
      }
    }

    const wishlist = getWishlist();
    wishlistBtns.forEach(function(btn) {
      const productId = btn.dataset.productId;
      if (!productId) return;
      
      if (wishlist.includes(productId)) {
        btn.classList.add('is-active');
        btn.setAttribute('aria-label', 'Remove from wishlist');
      }

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        let currentWishlist = getWishlist();
        
        if (btn.classList.contains('is-active')) {
          currentWishlist = currentWishlist.filter(function(id) { return id !== productId; });
          btn.classList.remove('is-active');
          btn.setAttribute('aria-label', 'Add to wishlist');
        } else {
          currentWishlist.push(productId);
          btn.classList.add('is-active');
          btn.setAttribute('aria-label', 'Remove from wishlist');
        }
        
        if (saveWishlist(currentWishlist)) {
          const headerCount = document.querySelector('[data-wishlist-count]');
          if (headerCount) {
            headerCount.textContent = currentWishlist.length;
            headerCount.style.display = currentWishlist.length > 0 ? 'flex' : 'none';
          }
        }
      });
    });

    // Add to cart functionality
    const addToCartBtns = section.querySelectorAll('[data-add-to-cart]');
    addToCartBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const variantId = btn.dataset.variantId;
        const originalText = btn.textContent;
        
        if (!variantId) {
          console.error('No variant ID found');
          btn.textContent = 'ERROR';
          setTimeout(function() { btn.textContent = originalText; }, 2000);
          return;
        }

        btn.disabled = true;
        btn.textContent = 'ADDING...';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({
            items: [{
              id: variantId,
              quantity: 1
            }]
          })
        })
        .then(function(response) {
          if (!response.ok) throw new Error('Network response was not ok');
          return response.json();
        })
        .then(function() {
          return fetch('/cart.js');
        })
        .then(function(response) { return response.json(); })
        .then(function(cart) {
          const cartCount = document.querySelector('[data-cart-count]');
          if (cartCount) {
            cartCount.textContent = cart.item_count;
            cartCount.style.display = cart.item_count > 0 ? 'flex' : 'none';
          }
          
          btn.textContent = 'ADDED!';
          setTimeout(function() {
            btn.textContent = originalText;
            btn.disabled = false;
          }, 2000);
        })
        .catch(function(error) {
          console.error('Error adding to cart:', error);
          btn.textContent = 'FAILED';
          setTimeout(function() {
            btn.textContent = originalText;
            btn.disabled = false;
          }, 2000);
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Product Carousel",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "CANDLES"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Lorem ipsum dolor sit amet consectetur."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 8,
      "info": "If the collection has fewer products, they will be repeated to fill this amount"
    }
  ],
  "presets": [
    {
      "name": "Product Carousel"
    }
  ]
}
{% endschema %}